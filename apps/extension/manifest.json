{
  "manifest_version": 3,
  "name": "MarketScope",
  "version": "0.0.0",
  "permissions": ["alarms", "storage"],
  "host_permissions": [
    "https://*.ts.net/*",
    "https://*.fbcdn.net/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "optional_host_permissions": ["http://*/*"],
  "background": {
    "service_worker": "dist/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://www.facebook.com/marketplace/*"],
      "js": ["dist/content.js"]
    }
  ]
}
