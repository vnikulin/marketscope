# The release installer writes /opt/marketscope/.env. Do not commit the real
# file. The session signing key is a separate 0600 file under
# /var/lib/marketscope and never belongs in this file.
MARKETSCOPE_IMAGE=ghcr.io/owner/repository
MARKETSCOPE_TAG=latest
MARKETSCOPE_BIND_ADDRESS=127.0.0.1
MARKETSCOPE_PORT=3000
MARKETSCOPE_EXTENSION_VERSION=0.0.0
MARKETSCOPE_RELEASE_URL=https://github.com/owner/repository/releases/latest/download
